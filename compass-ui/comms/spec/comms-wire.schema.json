{
  "$schema": "https://json-schema.org",
  "$id": "https://mtchship.com",
  "title": "MTCHSHIP Compass UI Comms Wire Contract",
  "type": "object",
  "required": ["type", "ticketId", "timestamp"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "MESSAGE_OUT",
        "MESSAGE_IN",
        "FORM_RENDER",
        "FORM_SUBMIT",
        "CALL_INTENT",
        "CALL_STATE",
        "CALLBACK_INITIATE",
        "AGENT_PRESENCE",
        "AGENT_PROFILE_UPDATE"
      ]
    },
    "ticketId": { "type": "string" },
    "timestamp": { "type": "integer" },
    "sender": {
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["CUSTOMER", "CHAT_ASSISTANT", "HUMAN_AGENT"] },
        "displayName": { "type": "string" },
        "avatarMode": { "type": "string", "enum": ["AGENT_PHOTO", "COMPANY_LOGO"] },
        "avatarUrl": { "type": ["string", "null"] }
      },
      "required": ["role", "displayName", "avatarMode"]
    },
    "payload": { "type": "object" }
  }
}
